# ─────────────────────────────────────────────────────────────────────────────
#  ANTIVENOM — environment
#  cp .env.example .env  and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas. MUST be the Hackathon Sandbox cluster from the emailed link —
# a build outside the sandbox is ineligible for the finalist round.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=antivenom

# Which model backend to use: openrouter | fireworks | local
ANTIVENOM_PROVIDER=openrouter
# Route model calls through LangChain instead of the raw OpenAI client.
# Same behaviour; buys provider-agnostic handles and a place for tracing.
ANTIVENOM_USE_LANGCHAIN=0

# OpenRouter (OpenAI-compatible). Supplies the VLM and the ablation model.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fireworks (also OpenAI-compatible). Model ids look like
# accounts/fireworks/models/<name> — VERIFY a current one, do not guess.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# ─── models ──────────────────────────────────────────────────────────────────
# The values below were verified against the live OpenRouter model list on
# 2026-08-13. Re-check before the event: ids churn, and a stale one 404s on
# stage. `antivenom doctor` fails until all three are set.

# Vision model, reads the payload out of the image. This one has to be good
# rather than cheap: it is reading 8.5px low-contrast text in a footer, which
# is exactly what a small model gets wrong.
ANTIVENOM_VLM_MODEL=google/gemini-2.5-flash

# Ablation. Runs passes x candidates times per diagnosis (24 on the seeded
# scenario), so cost and latency bite hardest here. Verified to actually emit
# the tool call: gpt-5-nano returns 200 with empty content and no tool call,
# because reasoning models spend the budget before answering.
ANTIVENOM_ABLATION_MODEL=google/gemini-2.5-flash-lite

# The victim agent. Needs tool calling and enough sense to follow a stored
# policy without being told to.
ANTIVENOM_AGENT_MODEL=google/gemini-2.5-flash

# ─── embeddings: MongoDB's own API, not the chat provider ────────────────────
# OpenRouter serves no embeddings endpoint, so vectors come from MongoDB's
# Embedding and Reranking API (Voyage AI). That is not a workaround: it keeps
# embeddings, the vector index and the graph traversal all on one platform.
#
# Get the key from the Atlas UI, or use a Voyage key directly and point
# MONGODB_EMBEDDING_BASE_URL at https://api.voyageai.com/v1 instead.
# Leave the key blank to keep the offline lexical embedding, which works but
# is not semantic.
MONGODB_EMBEDDING_API_KEY=
MONGODB_EMBEDDING_BASE_URL=https://ai.mongodb.com/v1
ANTIVENOM_EMBEDDING_MODEL=voyage-3.5
# Must match the Atlas vector index exactly, or every search returns nothing
# with no error at all.
ANTIVENOM_EMBEDDING_DIMS=1024

# ElevenLabs. DEFENSE SIDE ONLY — the cross-examination interface.
# Never used to generate an attack payload.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=

# ─── feature flags ───────────────────────────────────────────────────────────
# Each degrades to a local no-op fallback. All three off is the "demo floor":
# the full plant -> fire -> diagnose -> operate loop must still run and the
# cascade must still render.
#   mongo=0 -> in-memory graph store   vlm=0 -> cached extraction   voice=0 -> text
ANTIVENOM_FEATURE_MONGO=1
ANTIVENOM_FEATURE_VLM=1
ANTIVENOM_FEATURE_VOICE=1

# ─── run parameters (demo-tuned) ─────────────────────────────────────────────
ANTIVENOM_ABLATION_PASSES=3
ANTIVENOM_BLAST_MAX_DEPTH=6
ANTIVENOM_SUPPORT_THRESHOLD=1
ANTIVENOM_TRUST_DAMPING=0.6
ANTIVENOM_RANDOM_SEED=1337
ANTIVENOM_BENIGN_SESSIONS=20

# ─── event server ────────────────────────────────────────────────────────────
ANTIVENOM_HOST=127.0.0.1
ANTIVENOM_PORT=8787
